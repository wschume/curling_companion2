rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isVerified() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.organizerId == request.auth.uid;
      allow update: if isVerified()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if isSignedIn()
        && resource.data.organizerId == request.auth.uid
        && resource.data.endDate > request.time;
    }

    match /playerAvailability/{playerId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow update: if isVerified() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /teamPlayerSearches/{searchId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isVerified() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /playerTeamSearches/{searchId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isVerified() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isSignedIn() { return request.auth != null; }
    function isOrganizer() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['organizer', 'admin'];
    }
  }
}
