rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if canPost() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canPost() && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if canPost() && request.resource.data.organizerId == request.auth.uid;
      allow update: if canPost()
        && (resource.data.organizerId == request.auth.uid || isAdmin())
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if isSignedIn()
        && (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    match /playerAvailability/{playerId} {
      allow read: if true;
      allow create: if canPost() && request.resource.data.userId == request.auth.uid;
      allow update: if canPost() && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /teamPlayerSearches/{searchId} {
      allow read: if true;
      allow create: if canPost() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canPost() && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /playerTeamSearches/{searchId} {
      allow read: if true;
      allow create: if canPost() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canPost() && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/termsAcceptances/{version} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && version == '2026-10-07'
        && request.resource.data.keys().hasOnly(['version', 'accepted', 'acceptedAt', 'language'])
        && request.resource.data.version == version
        && request.resource.data.accepted == true
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.language in ['en', 'de'];
      allow update, delete: if false;
    }

    function canPost() {
      return isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/termsAcceptances/2026-10-07)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/termsAcceptances/2026-10-07).data.accepted == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/termsAcceptances/2026-10-07).data.version == '2026-10-07';
    }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isSignedIn() { return request.auth != null; }
    match /adminRoles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
